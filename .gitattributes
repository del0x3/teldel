# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF line endings for POSIX/Android compatibility
*.sh text eol=lf

# Windows batch & PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation & configuration
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python sources
*.py text eol=lf

# Binary files
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
